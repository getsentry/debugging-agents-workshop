      },
      "limit": 5,
      "queries": [
        {
          "aggregates": [
            "avg(gen_ai.cost.total_tokens)"
          ],
          "columns": [
            "release"
          ],
          "conditions": "gen_ai.operation.type:ai_client project.id:{{PROJECT_ID}}",
          "fieldAliases": [],
          "fields": [
            "release",
            "avg(gen_ai.cost.total_tokens)"
          ],
          "name": "",
          "orderby": ""
        }
      ],
      "thresholds": null,
