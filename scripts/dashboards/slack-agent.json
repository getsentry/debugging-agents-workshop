      "widgetType": "spans"
    },
    {
      "displayType": "big_number",
      "interval": "5m",
      "layout": {
        "h": 1,
        "minH": 1,
        "w": 2,
        "x": 4,
        "y": 0
      },
      "limit": null,
      "queries": [
        {
          "aggregates": [
            "avg(gen_ai.cost.total_tokens)"
          ],
