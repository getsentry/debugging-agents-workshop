            "count_unique(gen_ai.conversation.id)"
          ],
          "columns": [
            "user.id"
          ],
          "conditions": "gen_ai.operation.type:ai_client has:user.id project.id:{{PROJECT_ID}}",
          "fieldAliases": [
            "Slack user",
            "spend USD",
            "model calls",
            "conversations"
          ],
          "fields": [
            "user.id",
            "sum(gen_ai.cost.total_tokens)",
            "count()",
            "count_unique(gen_ai.conversation.id)"
          ],
          "name": "",
          "orderby": "-sum(gen_ai.cost.total_tokens)"
