    {
      "displayType": "table",
      "interval": "5m",
      "layout": {
        "h": 2,
        "minH": 2,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "limit": 10,
      "queries": [
        {
          "aggregates": [
            "sum(gen_ai.cost.total_tokens)",
            "count()",
            "sum(gen_ai.usage.input_tokens)"
          ],
          "columns": [
            "gen_ai.conversation.id",
            "user.id"
          ],
          "conditions": "gen_ai.operation.type:ai_client has:gen_ai.conversation.id project.id:{{PROJECT_ID}}",
