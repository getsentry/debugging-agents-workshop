          ],
          "conditions": "span.op:slack.message project.id:{{PROJECT_ID}}",
          "fieldAliases": [
            "channel type",
            "messages",
            "people",
            "p95 ms"
          ],
          "fields": [
            "slack.channel_type",
            "count()",
            "count_unique(user.id)",
            "p95(span.duration)"
          ],
          "name": "",
          "orderby": "-count()"
        }
      ],
      "thresholds": null,
