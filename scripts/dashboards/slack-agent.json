{
  "environment": [],
  "filters": {},
  "period": "7d",
  "projects": [
    -1
  ],
  "title": "Slack bot: who asks, what it costs",
  "widgets": [
    {
      "displayType": "big_number",
      "interval": "5m",
      "layout": {
        "h": 1,
        "minH": 1,
        "w": 1,
        "x": 0,
        "y": 0
      },
      "limit": null,
      "queries": [
        {
          "aggregates": [
            "sum(gen_ai.cost.total_tokens)"
          ],
          "columns": [],
          "conditions": "gen_ai.operation.type:ai_client project.id:{{PROJECT_ID}}",
          "fieldAliases": [],
          "fields": [
            "sum(gen_ai.cost.total_tokens)"
          ],
          "name": "",
          "orderby": ""
        }
      ],
      "thresholds": null,
      "title": "Model spend, USD",
      "widgetType": "spans"
    },
    {
      "displayType": "big_number",
      "interval": "5m",
      "layout": {
        "h": 1,
        "minH": 1,
        "w": 1,
        "x": 1,
        "y": 0
      },
      "limit": null,
      "queries": [
        {
          "aggregates": [
            "count()"
          ],
          "columns": [],
          "conditions": "span.op:slack.message project.id:{{PROJECT_ID}}",
          "fieldAliases": [],
          "fields": [
            "count()"
          ],
          "name": "",
          "orderby": ""
        }
      ],
      "thresholds": null,
      "title": "Questions answered",
      "widgetType": "spans"
    },
    {
      "displayType": "big_number",
