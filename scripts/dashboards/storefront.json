          "conditions": "span.op:gen_ai.execute_tool project.id:{{PROJECT_ID}}",
          "fieldAliases": [],
          "fields": [
            "gen_ai.tool.name",
            "count()",
            "failure_count()",
            "p95(span.duration)"
          ],
          "name": "",
          "orderby": "-failure_count()"
        }
      ],
      "thresholds": null,
      "title": "Tool calls and failures",
      "widgetType": "spans"
    },
    {
