        "minH": 1,
        "w": 1,
        "x": 0,
        "y": 0
      },
      "limit": null,
      "queries": [
        {
          "aggregates": [
            "failure_count()"
          ],
          "columns": [],
          "conditions": "span.op:gen_ai.execute_tool project.id:{{PROJECT_ID}}",
          "fieldAliases": [],
          "fields": [
            "failure_count()"
          ],
          "name": "",
          "orderby": ""
        }
      ],
      "thresholds": null,
      "title": "Tool failures",
      "widgetType": "spans"
    },
    {
      "displayType": "big_number",
      "interval": "5m",
      "layout": {
        "h": 1,
        "minH": 1,
        "w": 1,
