            "conversation",
            "customer id",
            "email",
            "spend USD",
            "model calls",
            "input tokens"
          ],
          "fields": [
            "gen_ai.conversation.id",
            "user.id",
            "user.email",
            "sum(gen_ai.cost.total_tokens)",
            "count()",
            "sum(gen_ai.usage.input_tokens)"
          ],
          "name": "",
          "orderby": "-sum(gen_ai.cost.total_tokens)"
