      "limit": null,
      "queries": [
        {
          "aggregates": [
            "equation|100 * sum(gen_ai.usage.cache_read.input_tokens) / sum(gen_ai.usage.input_tokens)"
          ],
          "columns": [],
          "conditions": "gen_ai.operation.type:ai_client has:gen_ai.usage.input_tokens project.id:{{PROJECT_ID}}",
          "fieldAliases": [],
          "fields": [
            "equation|100 * sum(gen_ai.usage.cache_read.input_tokens) / sum(gen_ai.usage.input_tokens)"
          ],
          "name": "",
          "orderby": ""
        }
      ],
      "thresholds": null,
