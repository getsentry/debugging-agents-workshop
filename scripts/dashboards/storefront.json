          "aggregates": [
            "count_unique(gen_ai.conversation.id)"
          ],
          "columns": [],
          "conditions": "gen_ai.operation.type:ai_client project.id:{{PROJECT_ID}}",
          "fieldAliases": [],
          "fields": [
            "count_unique(gen_ai.conversation.id)"
          ],
          "name": "",
          "orderby": ""
        }
      ],
      "thresholds": null,
      "title": "Conversations",
      "widgetType": "spans"
