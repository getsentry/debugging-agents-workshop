{
  "workflowName": "Slack agent alerts",
  "detectors": [
    {
      "name": "Cache misses on model calls",
      "type": "metric_issue",
      "config": { "detectionType": "static" },
      "owner": null,
      "dataSources": [
        {
          "type": "snuba_query_subscription",
          "dataset": "events_analytics_platform",
          "eventTypes": ["trace_item_span"],
          "query": "span.op:gen_ai.generate_content gen_ai.usage.cache_read.input_tokens:0",
          "aggregate": "count()",
          "timeWindow": 600,
          "environment": null
        }
      ],
      "conditionGroup": {
        "logicType": "any",
        "conditions": [
          { "type": "gt", "comparison": 2, "conditionResult": 75 },
          { "type": "lte", "comparison": 2, "conditionResult": 0 }
        ]
      }
    }
  ]
}
