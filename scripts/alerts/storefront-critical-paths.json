{
  "_readme": [
    "The presenter's copy of the lab 6 alerts for the storefront project.",
    "Create the workflow first, then post each detector with the workflow id:",
    "  sentry api -X POST organizations/<org>/workflows/ -d @<workflow>",
    "  sentry api -X POST organizations/<org>/projects/<project>/detectors/ -d @<detector>",
    "Replace <user id> with the id from organizations/<org>/members/.",
    "conditionResult 75 = critical, 50 = warning, 0 = resolved."
  ],
  "workflow": {
    "name": "Storefront agent alerts",
    "enabled": true,
    "triggers": { "logicType": "any", "conditions": [] },
    "actionFilters": [
      {
        "logicType": "any",
        "conditions": [],
        "actions": [
          { "type": "email", "data": {}, "config": { "targetType": "user", "targetIdentifier": "<user id>" } }
        ]
      }
    ]
  },
  "detectors": [
    {
      "name": "Refund tool failures",
      "type": "metric_issue",
      "dataSources": [{ "type": "snuba_query_subscription", "dataset": "events_analytics_platform", "eventTypes": ["trace_item_span"],
        "query": "gen_ai.operation.name:execute_tool gen_ai.tool.name:refundOrder span.status:error", "aggregate": "count()", "timeWindow": 600, "environment": null }],
      "conditionGroup": { "logicType": "any", "conditions": [
        { "type": "gt", "comparison": 3, "conditionResult": 75 },
        { "type": "lte", "comparison": 3, "conditionResult": 0 } ] },
      "workflowIds": ["<workflow id>"],
      "config": { "detectionType": "static" },
      "owner": null
    },
    {
      "name": "Model call failure rate",
      "type": "metric_issue",
      "dataSources": [{ "type": "snuba_query_subscription", "dataset": "events_analytics_platform", "eventTypes": ["trace_item_span"],
        "query": "gen_ai.operation.name:generate_content", "aggregate": "failure_rate()", "timeWindow": 300, "environment": null }],
      "conditionGroup": { "logicType": "any", "conditions": [
        { "type": "gt", "comparison": 0.1, "conditionResult": 75 },
        { "type": "lte", "comparison": 0.1, "conditionResult": 0 } ] },
      "workflowIds": ["<workflow id>"],
      "config": { "detectionType": "static" },
      "owner": null
    },
    {
      "name": "Slow agent turns",
      "type": "metric_issue",
      "dataSources": [{ "type": "snuba_query_subscription", "dataset": "events_analytics_platform", "eventTypes": ["trace_item_span"],
        "query": "gen_ai.operation.name:invoke_agent", "aggregate": "p95(span.duration)", "timeWindow": 600, "environment": null }],
      "conditionGroup": { "logicType": "any", "conditions": [
        { "type": "gt", "comparison": 15000, "conditionResult": 75 },
        { "type": "lte", "comparison": 15000, "conditionResult": 0 } ] },
      "workflowIds": ["<workflow id>"],
      "config": { "detectionType": "static" },
      "owner": null
    },
    {
      "name": "Token spend spike",
      "type": "metric_issue",
      "dataSources": [{ "type": "snuba_query_subscription", "dataset": "events_analytics_platform", "eventTypes": ["trace_item_span"],
        "query": "gen_ai.operation.name:generate_content", "aggregate": "sum(gen_ai.usage.input_tokens)", "timeWindow": 3600, "environment": null }],
      "conditionGroup": { "logicType": "any", "conditions": [
        { "type": "anomaly_detection", "comparison": { "sensitivity": "medium", "seasonality": "auto", "thresholdType": 0 }, "conditionResult": 75 } ] },
      "workflowIds": ["<workflow id>"],
      "config": { "detectionType": "dynamic" },
      "owner": null
    }
  ]
}
