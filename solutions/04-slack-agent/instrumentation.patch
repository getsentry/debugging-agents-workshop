+// Shared body for both handlers: wraps one Slack message in one Sentry
+// transaction, so the model call and tool calls the AI SDK's telemetry
+// produces nest inside it, and scopes the Sentry user to that message.
+async function handleMessage({
+  client,
+  say,
+  event,
+  conversationId,
+  text,
+  slackEvent,
+}: {
+  client: WebClient;
+  say: SayFn;
+  event: { channel: string; ts: string; thread_ts?: string; user?: string };
+  conversationId: string;
+  text: string;
+  slackEvent: "app_mention" | "message.im";
+}): Promise<void> {
+  await Sentry.startSpan(
+    {
+      name: "slack.message",
+      op: "slack.message",
+      forceTransaction: true,
+      attributes: {
+        "gen_ai.conversation.id": conversationId,
+        "slack.channel": event.channel,
+        "slack.event": slackEvent,
+      },
+    },
+    async () => {
+      Sentry.getCurrentScope().setUser(event.user ? { id: event.user } : null);
+
+      try {
+        const messages = await loadThread({ client, event, conversationId, text });
+        const reply = await answer({ messages, conversationId });
