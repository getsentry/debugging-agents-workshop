@@ -0,0 +1,15 @@
+import * as Sentry from "@sentry/nextjs";
+
+Sentry.init({
+  dsn: process.env.SENTRY_DSN,
+  // Sample every trace and send full request context — this is a demo; dial
+  // down for real traffic.
+  tracesSampleRate: 1.0,
+  sendDefaultPii: true,
+  enableLogs: true,
+  integrations: [
+    // Records prompts, tool calls, tool results, and token usage on the
+    // gen_ai spans the Vercel AI SDK's telemetry produces.
+    Sentry.vercelAIIntegration({ recordInputs: true, recordOutputs: true }),
+  ],
+});
