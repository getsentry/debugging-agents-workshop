diff --git a/apps/storefront/instrumentation-client.ts b/apps/storefront/instrumentation-client.ts
new file mode 100644
index 0000000..3975958
--- /dev/null
+++ b/apps/storefront/instrumentation-client.ts
@@ -0,0 +1,15 @@
+import * as Sentry from "@sentry/nextjs";
+
+Sentry.init({
+  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN,
+  // Sample every trace and record every session — this is a demo; dial down
+  // for real traffic.
+  tracesSampleRate: 1.0,
+  sendDefaultPii: true,
+  replaysSessionSampleRate: 1.0,
+  replaysOnErrorSampleRate: 1.0,
+  integrations: [Sentry.replayIntegration()],
+});
+
+// Instruments App Router navigations so client traces connect to server ones.
+export const onRouterTransitionStart = Sentry.captureRouterTransitionStart;
diff --git a/apps/storefront/instrumentation.ts b/apps/storefront/instrumentation.ts
new file mode 100644
index 0000000..034c3b1
--- /dev/null
+++ b/apps/storefront/instrumentation.ts
@@ -0,0 +1,14 @@
+import * as Sentry from "@sentry/nextjs";
+
+export async function register() {
+  if (process.env.NEXT_RUNTIME === "nodejs") {
+    await import("./sentry.server.config");
+  }
+
+  if (process.env.NEXT_RUNTIME === "edge") {
+    await import("./sentry.edge.config");
+  }
+}
+
+// Capture errors from Server Components, middleware, and proxies.
+export const onRequestError = Sentry.captureRequestError;
