diff --git a/apps/pr-reviewer/.env.example b/apps/pr-reviewer/.env.example
index 0000000..0000000 100644
--- a/apps/pr-reviewer/.env.example
+++ b/apps/pr-reviewer/.env.example
@@ -1,4 +1,7 @@
 OPENROUTER_API_KEY=
 
+# This project's DSN in Sentry (Settings > Projects > <project> > Client Keys).
+SENTRY_DSN=
+
 # GITHUB_REPOSITORY, GITHUB_TOKEN, PR_NUMBER, and PR_DESCRIPTION come from
 # GitHub Actions (see .github/workflows/review.yml) and are not set locally.
diff --git a/apps/pr-reviewer/.github/workflows/review.yml b/apps/pr-reviewer/.github/workflows/review.yml
index 0000000..0000000 100644
--- a/apps/pr-reviewer/.github/workflows/review.yml
+++ b/apps/pr-reviewer/.github/workflows/review.yml
@@ -31,4 +31,5 @@ jobs:
           GITHUB_REPOSITORY: ${{ github.repository }}
           PR_NUMBER: ${{ github.event.pull_request.number }}
           PR_DESCRIPTION: ${{ github.event.pull_request.body }}
+          SENTRY_DSN: ${{ secrets.SENTRY_DSN }}
         run: npx flue run src/agents/review.ts --message 'Review the diff at fixtures/latest.diff and post your review.'
diff --git a/apps/pr-reviewer/README.md b/apps/pr-reviewer/README.md
index 0000000..0000000 100644
--- a/apps/pr-reviewer/README.md
+++ b/apps/pr-reviewer/README.md
@@ -30,5 +30,10 @@ to `review.md` instead of posted to a pull request.
 
 ## Sentry
 
-This app has no Sentry code. Sentry instrumentation is added in
-`labs/05-pr-reviewer.md`.
+Set `SENTRY_DSN` (locally in `.env`, in CI as the `SENTRY_DSN` repository
+secret) to send traces and logs to Sentry. One run produces a trace with a
+root span for the lead agent, a chat span per lead model turn, a tool span
+per `read_diff`/`post_review` call, and two subagent spans (one for
+`correctness-reviewer`, one for `style-reviewer`) with their own chat and
+tool spans nested underneath. `environment` is `github-actions` in CI and
+`local` otherwise; `release` is the workflow's `GITHUB_SHA`.
