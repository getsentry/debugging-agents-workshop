diff --git a/apps/pr-reviewer/src/sentry.ts b/apps/pr-reviewer/src/sentry.ts
new file mode 100644
index 0000000..5192fcf
--- /dev/null
+++ b/apps/pr-reviewer/src/sentry.ts
@@ -0,0 +1,74 @@
+// The whole Sentry setup for this app — the agent code makes no Sentry calls
+// beyond the import in review.ts.
+
+import { createOpenTelemetryInstrumentation } from '@flue/opentelemetry';
+import { instrument } from '@flue/runtime';
+import * as Sentry from '@sentry/node';
+
+// Sentry ships integrations that patch AI provider SDKs directly. Flue's
+// instrumentation already emits one `chat` span per model turn, so those
+// integrations would double-count every model call.
+const AI_PROVIDER_INTEGRATIONS = new Set([
+	'Anthropic_AI',
+	'OpenAI',
+	'Google_GenAI',
+	'LangChain',
+	'LangGraph',
+	'VercelAI',
+	'WorkersAI',
+]);
+
+function remapToolPayload(span: Parameters<Parameters<typeof Sentry.withStreamedSpan>[0]>[0]) {
+	const attributes = span.attributes;
+	if (attributes) {
+		for (const kind of ['arguments', 'result'] as const) {
+			const raw = attributes[`flue.tool.call.${kind}`];
+			if (raw !== undefined) {
