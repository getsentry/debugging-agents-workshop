index 0000000..0000000 100644
--- a/.github/workflows/review.yml
+++ b/.github/workflows/review.yml
@@ -42,4 +42,5 @@ jobs:
           GITHUB_REPOSITORY: ${{ github.repository }}
           PR_NUMBER: ${{ github.event.pull_request.number }}
