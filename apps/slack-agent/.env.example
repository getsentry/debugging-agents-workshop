# From OAuth & Permissions, after installing the app to your workspace.
SLACK_BOT_TOKEN=

# From Basic Information > App-Level Tokens. Create one with the
# connections:write scope.
SLACK_APP_TOKEN=

# OpenRouter API key — shared key from the presenter
OPENROUTER_API_KEY=

# Copy from apps/storefront/.env.local - the bot reads the same database.
DATABASE_URL=

# Optional. One of the SUPPORTED_MODELS in ../storefront/lib/ai/models.ts.
# Defaults to anthropic/claude-sonnet-5.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
