# From OAuth & Permissions, after installing the app to your workspace.
SLACK_BOT_TOKEN=

# From Basic Information > App-Level Tokens. Create one with the
# connections:write scope.
SLACK_APP_TOKEN=

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Same Neon connection string as apps/storefront/.env.local
DATABASE_URL=

# Optional. One of anthropic/claude-sonnet-5, anthropic/claude-haiku-4.5,
# openai/gpt-5-mini, google/gemini-2.5-flash. Defaults to
# anthropic/claude-sonnet-5.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Sentry DSN for this project (Project Settings > Client Keys)
SENTRY_DSN=
# Optional. Defaults to "development".
SENTRY_ENVIRONMENT=
# Optional. Tags every span and error with the release that produced it.
SENTRY_RELEASE=
