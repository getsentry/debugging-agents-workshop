# Postgres connection strings (Neon). scripts/setup.sh fills these in for you
# with `npx neon@latest claim create`. The app uses the pooled URL; drizzle-kit
# uses the unpooled one when present.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Mistral API key (https://console.mistral.ai/api-keys) — powers the shopping assistant
MISTRAL_API_KEY=
# Optional model id; must be one of SUPPORTED_MODELS in lib/ai/models.ts,
# otherwise the default (mistral-small-latest) is used
MISTRAL_MODEL=

# Storefront branding shown in the layout metadata and footer
COMPANY_NAME="Acme, Inc."
SITE_NAME="Acme Store"

# Sentry variables are added in labs/02-instrument-storefront.md.
